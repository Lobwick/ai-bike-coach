# Copier en `.env`, remplir, puis `chmod 600 .env`. Ne JAMAIS versionner ce fichier rempli.
COACH_HOST=<ton-domaine>.freeboxos.fr
# Dossier de données sur la Freebox (dépôt git privé, source de vérité) — créé par migrate-from-mac.sh
DATA_DIR=/home/<utilisateur>/coach-data
COACH_UID=1000
COACH_GID=1000
# Jeton de l'API MCP (≥ 24 caractères) :  openssl rand -hex 32
COACH_MCP_TOKEN=
# Accès au site (basicAuth Traefik), ENTRE APOSTROPHES (le hash contient des $) :  htpasswd -nbB <utilisateur> 'mot-de-passe'
COACH_BASIC_AUTH=''
