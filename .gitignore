# tests/evals/fixtures/*/activities/ et consorts.
/activities/
/medical/
/nutrition/
/planning/
/rapports/
/resources/

# Secrets & tokens
*.token
*.tokens.json
.garminconnect/
.env
.env.local
# Sauvegardes et temporaires de scripts/coach_config.py : `workspace.user.toml.bak` contient
# le sujet ntfy (seul secret sur ntfy.sh), `.mcp.json.bak` la configuration MCP.
*.bak
.arc-*.tmp

# Python
__pycache__/
*.py[cod]
.venv/

# OS
.DS_Store

